<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Settings -->
        <record model="res.config.settings" id="freppledata_res_config_settings">
            <field name="group_mrp_routings" eval="1" />
            <field name="module_mrp_subcontracting" eval="1" />
            <field name="group_mrp_byproducts" eval="1" />
            <field name="group_stock_multi_locations" eval="1" />
            <field name="group_stock_adv_location" eval="1" />
        </record>
        <function model="res.config.settings" name="set_values">
            <value model="res.config.settings" search="[]"/>
        </function>

        <!-- Activate multi-step picking, production and deliveries -->
        <record id="stock.warehouse0" model="stock.warehouse">
            <field name="delivery_steps">pick_pack_ship</field>
            <field name="reception_steps">two_steps</field>
            <field name="manufacture_steps">pbm_sam</field>
        </record>

        <!-- Unarchive MTO route -->
        <record id="stock.route_warehouse0_mto" model="stock.route">
            <field name="active" eval="1"/>
        </record>
        <record id="mrp_subcontracting.route_resupply_subcontractor_mto" model="stock.route">
            <field name="active" eval="1"/>
        </record>

        <!-- Allow buy & manufacturing routes to be selected on the product -->
        <record id="purchase_stock.route_warehouse0_buy" model="stock.route">
            <field name="product_selectable" eval="True"/>
        </record>
        <record id="mrp.route_warehouse0_manufacture" model="stock.route">
            <field name="product_selectable" eval="True"/>
        </record>
    </data>
</odoo>
