<?xml version="1.0"?>
<odoo>
    <data noupdate="0">
        <record id="frepple_user" model="res.groups">
            <field name="name">frePPLe user</field>

            <field name="comment">Allow this user to access the frepple application</field>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]" />
        </record>
    </data>
    <data noupdate="0">
        <record id="frepple_quoting_user" model="res.groups">
            <field name="name">frePPLe quoting user</field>

            <field name="comment">Allow this user to access the frepple quoting module</field>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]" />
        </record>
    </data>
    <!-- Uncomment to grant frepple access by default
    <data noupdate="1">
        <record id="base.default_user" model="res.users">
            <field name="groups_id" eval="[(4,ref('frepple_user'))]"/>
        </record>
	</data>
    -->
    <data noupdate="1">
        <record id="frepple_recommendation_company_rule" model="ir.access">
            <field name="name">Frepple Recommendation: multi-company</field>
            <field name="model_id" ref="model_frepple_recommendation"/>
            <field name="operation">crud</field>
            <field name="domain">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
