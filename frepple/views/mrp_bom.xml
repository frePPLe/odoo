<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_bom_form_view_frepple" model="ir.ui.view">
        <field name="name">mrp.workcenter.inherit.tree</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_qty']/../.." position="inside">
                <field name="product_qty_multiple" string="Quantity Multiple"/>
                <field name="scrap_rate" string="Scrap Rate" widget="percentage"/>

            </xpath>
        </field>
    </record>
    <record id="mrp_bom_tree_view_frepple" model="ir.ui.view">
        <field name="name">mrp.bom.list</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_tree_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='uom_id']" position="after">
                <field name="product_qty_multiple" optional="hide"/>
                <field name="scrap_rate" string="Scrap Rate" widget="percentage" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
